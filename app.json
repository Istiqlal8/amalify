{
  "expo": {
    "name": "Amalify",
    "slug": "amalify",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "amalify",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amalify.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EC4899",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amalify.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF2F8"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.917769857312-ebgndesq494j7k20lcqhe15srr17jtqg"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#DB2777"
              },
              "colorControlActivated": {
                "light": "#EC4899"
              },
              "colorControlHighlight": {
                "light": "#FBCFE8"
              },
              "textColorPrimary": {
                "light": "#831843"
              }
            },
            "timePicker": {
              "headerBackground": {
                "light": "#DB2777"
              },
              "numbersSelectorColor": {
                "light": "#EC4899"
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EC4899",
          "sounds": ["./assets/sounds/notif/lembut.wav", "./assets/sounds/notif/ceria.wav"]
        }
      ],
      "./plugins/withEasDebugSigning",
      [
        "./plugins/withPinkAccent",
        {
          "color": "#DB2777"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai untuk menentukan arah kiblat dari tempatmu."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mikrofon dipakai untuk merekam setoran hafalan.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Foto dipakai untuk avatar profilmu.",
          "cameraPermission": "Kamera dipakai untuk memotret nota belanja."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID dipakai untuk membuka menu Haid."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "395d4056-0120-4f0f-a3f4-4f1161ea41fe"
      }
    },
    "owner": "istiqlalbi",
    "updates": {
      "url": "https://u.expo.dev/395d4056-0120-4f0f-a3f4-4f1161ea41fe"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
