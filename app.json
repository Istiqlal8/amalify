{
  "expo": {
    "name": "Amalify",
    "slug": "amalify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amalify",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amalify.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EC4899",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amalify.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF2F8"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.917769857312-ebgndesq494j7k20lcqhe15srr17jtqg"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#DB2777"
              },
              "colorControlActivated": {
                "light": "#EC4899"
              },
              "colorControlHighlight": {
                "light": "#FBCFE8"
              },
              "textColorPrimary": {
                "light": "#831843"
              }
            },
            "timePicker": {
              "headerBackground": {
                "light": "#DB2777"
              },
              "numbersSelectorColor": {
                "light": "#EC4899"
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EC4899"
        }
      ],
      [
        "./plugins/withPinkAccent",
        {
          "color": "#DB2777"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai untuk menentukan arah kiblat dari tempatmu."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Foto dipakai untuk avatar profilmu.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
